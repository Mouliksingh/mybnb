<% layout("/layouts/boilerplate") %>

<div class="container mt-4 mb-5" style="max-width: 800px;">
  <div class="card shadow-sm border rounded-4 overflow-hidden">
    <div class="card-header bg-white py-3 px-4 d-flex align-items-center justify-content-between border-bottom">
      <div class="d-flex align-items-center gap-3">
        <a href="/messages" class="text-dark fs-5 text-decoration-none"><i class="fa-solid fa-arrow-left"></i></a>
        <div class="bg-dark text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px;">
          <%= partner.username.charAt(0).toUpperCase() %>
        </div>
        <div>
          <h6 class="mb-0 fw-bold">@<%= partner.username %></h6>
          <% if (listing) { %>
            <small class="text-danger fw-semibold"><i class="fa-solid fa-house me-1"></i> <%= listing.title %></small>
          <% } %>
        </div>
      </div>
    </div>

    <div class="card-body bg-light overflow-auto p-4" style="height: 450px; display: flex; flex-direction: column; gap: 12px;" id="chatBody">
      <% if (chatMessages && chatMessages.length > 0) { %>
        <% chatMessages.forEach(msg => { %>
          <% const isMe = msg.sender._id.equals(currUser._id); %>
          <div class="d-flex flex-column <%= isMe ? 'align-items-end' : 'align-items-start' %>">
            <div class="p-3 rounded-4 shadow-sm text-wrap <%= isMe ? 'bg-danger text-white' : 'bg-white text-dark border' %>" style="max-width: 75%; font-size: 0.95rem;">
              <%= msg.content %>
            </div>
            <small class="text-muted mt-1" style="font-size: 0.7rem;"><%= new Date(msg.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></small>
          </div>
        <% }) %>
      <% } else { %>
        <div class="text-center text-muted my-auto">
          <p class="small mb-0">No messages in this conversation yet. Send a message below!</p>
        </div>
      <% } %>
    </div>

    <div class="card-footer bg-white p-3 border-top">
      <form action="/messages/<%= partner._id %><%= listing ? '?listingId=' + listing._id : '' %>" method="POST" class="input-group">
        <input type="text" name="content" class="form-control rounded-pill px-4 py-2 border" placeholder="Type a message..." autocomplete="off" required>
        <% if (listing) { %>
          <input type="hidden" name="listingId" value="<%= listing._id %>">
        <% } %>
        <button type="submit" class="btn btn-danger rounded-pill px-4 ms-2 fw-semibold" style="background-color: #ff385c; border: none;">
          <i class="fa-solid fa-paper-plane"></i>
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  // Auto-scroll chat to bottom on load
  const chatBody = document.getElementById("chatBody");
  if (chatBody) {
    chatBody.scrollTop = chatBody.scrollHeight;
  }
</script>