<% layout("/layouts/boilerplate") %>

<div class="row mt-4">
  <div class="alert alert-danger col-8 offset-2 shadow-sm rounded-4 p-4" role="alert">
    <h4 class="alert-heading fw-bold mb-2">
      <i class="fa-solid fa-circle-exclamation me-2"></i>Error <%= typeof statusCode !== 'undefined' ? statusCode : 500 %>
    </h4>
    <p class="mb-0 fs-6"><%= typeof message !== 'undefined' ? message : "Something went wrong!" %></p>
    
    <% if (typeof err !== 'undefined' && err && err.stack && process.env.NODE_ENV !== "production") { %>
      <hr />
      <pre class="bg-light p-3 rounded-3 text-danger small font-monospace" style="white-space: pre-wrap;"><%= err.stack %></pre>
    <% } %>

    <div class="mt-3">
      <a href="/listings" class="btn btn-outline-danger btn-sm rounded-pill px-3">Back to Explore</a>
    </div>
  </div>
</div>