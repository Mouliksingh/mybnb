<% if (success && success.length) { %>
  <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mt-3 border-0 d-flex align-items-center" role="alert">
    <i class="fa-solid fa-circle-check fs-5 me-2"></i>
    <div><%= success %></div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<% if (error && error.length) { %>
  <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mt-3 border-0 d-flex align-items-center" role="alert">
    <i class="fa-solid fa-circle-exclamation fs-5 me-2"></i>
    <div><%= error %></div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>